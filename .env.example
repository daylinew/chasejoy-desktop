# Optional fallback keys (Settings UI is the preferred way; values stored encrypted via safeStorage).
# These are only read on first launch if no profile exists.

OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# Examples for OpenAI-compatible providers:
# DeepSeek      -> base URL https://api.deepseek.com/v1   model deepseek-chat
# Qwen          -> base URL https://dashscope.aliyuncs.com/compatible-mode/v1   model qwen-plus
# Moonshot      -> base URL https://api.moonshot.cn/v1   model moonshot-v1-32k
