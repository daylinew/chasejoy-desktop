{
  "name": "chasejoy-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "ChaseJoy - a personal AI desktop assistant powered by LangChain deepagents",
  "author": "ChaseJoy",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "rebuild": "node scripts/rebuild-native.js",
    "postinstall": "node scripts/rebuild-native.js",
    "package:win": "electron-vite build && electron-builder --win --x64",
    "package:mac": "electron-vite build && electron-builder --mac",
    "package:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.2",
    "@langchain/anthropic": "^1.3.26",
    "@langchain/core": "^1.1.47",
    "@langchain/deepseek": "^1.0.27",
    "@langchain/langgraph": "^1.3.0",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.1",
    "@langchain/openai": "^1.4.7",
    "@langchain/tavily": "^1.2.0",
    "better-sqlite3": "^11.7.0",
    "deepagents": "^1.10.2",
    "electron-store": "^10.0.1",
    "langchain": "^1.4.1",
    "nanoid": "^5.0.9",
    "openai": "^6.38.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.3.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "shiki": "^1.24.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "zustand": "^5.0.2"
  }
}
